<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only helper: gives the Electron app Bluetooth RFCOMM sockets through the
       Windows.Devices.Bluetooth API. Built with the .NET 8 SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>VShare.BluetoothBridge</AssemblyName>
    <RootNamespace>VShare.BluetoothBridge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
