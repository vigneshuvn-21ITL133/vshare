{
  "name": "@vshare/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "V_share Mobile: Android companion for wireless file transfer (Expo SDK 57)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "build:android": "eas build --profile production --platform android",
    "build:android:dev": "eas build --profile development --platform android",
    "export:android": "expo export --platform android",
    "eas-build-post-install": "pnpm --filter @vshare/protocol run build",
    "typecheck": "tsc --noEmit",
    "start:tunnel": "expo start --dev-client --tunnel"
  },
  "dependencies": {
    "@vshare/protocol": "workspace:*",
    "buffer": "^6.0.3",
    "expo": "~58.0.19",
    "expo-build-properties": "58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-media-library": "~58.0.12",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "fast-text-encoding": "^1.0.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-bluetooth-classic": "1.73.0-rc.17",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/fast-text-encoding": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3"
  }
}
